#!/usr/bin/env php
<?php

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

$app = new Symfony\Component\Console\Application('leafs/llms', '0.1.0');
$app->add(new Leaf\Llms\Commands\InitCommand());
$app->add(new Leaf\Llms\Commands\DetectCommand());
$app->run();
